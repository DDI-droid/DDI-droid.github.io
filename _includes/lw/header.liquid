{%- comment -%}
  Their header bar. The site links sit where their search and login are; on phones their menu
  button opens the links as a drawer. include.white: post-page variant of the bar.
{%- endcomment -%}
{%- assign author_name = site.first_name | append: ' ' | append: site.last_name -%}
{%- assign url_head = page.url | slice: 0, 6 -%}
{%- assign in_blog = false -%}
{%- if page.collection == 'posts' or url_head == '/blog/' -%}{%- assign in_blog = true -%}{%- endif -%}
{%- assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' -%}
{%- capture nav_links -%}
  <a class="Header-navLink{% if page.url == '/' %} is-current{% endif %}" href="{{ '/' | relative_url }}">about</a>
  {%- for p in nav_pages -%}
    {%- assign current = false -%}
    {%- if p.url == page.url -%}{%- assign current = true -%}{%- endif -%}
    {%- if p.url == '/blog/' and in_blog -%}{%- assign current = true -%}{%- endif -%}
    <a class="Header-navLink{% if current %} is-current{% endif %}" href="{{ p.url | relative_url }}">{{ p.title }}</a>
  {%- endfor -%}
{%- endcapture -%}
<div class="Header-root Header-headerHeight">
  <div class="Header-headroom headroom-wrapper">
    <div class="headroom headroom--unfixed" id="headroom">
      <header class="Header-appBar{% if include.white %} Header-blackBackgroundAppBar{% endif %}">
        <div class="Header-toolbar">
          <button class="MuiButtonBase-root MuiIconButton-root MuiIconButton-colorInherit Header-menuButton Header-hideSmUp" id="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
            <span class="MuiIconButton-label"><svg class="MuiSvgIcon-root" focusable="false" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path></svg></span>
          </button>
          <h2 class="Typography-root Typography-title Header-title">
            <a class="Header-titleLink" href="{{ '/' | relative_url }}">{{ author_name }}</a>
          </h2>
          <div class="Header-rightHeaderItems">
            <nav class="Header-navLinks Header-hideXsDown" aria-label="Site">{{ nav_links }}</nav>
            <button class="Header-themeToggle" id="theme-toggle" type="button" title="Change theme" aria-label="Change colour theme">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
          </div>
        </div>
      </header>
    </div>
  </div>
</div>
<nav class="site-menu" id="site-menu" aria-label="Site" hidden>{{ nav_links }}</nav>
