---
layout: default
---
{%- comment -%}
  lesswrong.com's post page, class for class: their MultiToCLayout grid with the contents rail,
  LWPostsPageHeader, ContentStyles-postBody, and the tag footer. Documents (projects, academics)
  use it too, with their description in the byline's place and no tags.
{%- endcomment -%}
{%- assign is_post = false -%}
{%- if page.collection == 'posts' -%}{%- assign is_post = true -%}{%- endif -%}
{%- capture title -%}{% include lw/page_title.liquid %}{%- endcapture -%}
{%- assign title = title | strip -%}
{%- assign year = page.date | date: '%Y' -%}
{%- assign last_date = page.last_modified_at | default: page.last_updated -%}
{%- assign read_time = content | number_of_words | divided_by: 220 | plus: 1 -%}
{%- assign author_name = site.first_name | append: ' ' | append: site.last_name -%}
{%- if page.author -%}{%- assign author_name = page.author -%}{%- endif -%}
{%- assign title_words = title | split: ' ' -%}
{%- assign last_word = title_words | last -%}
{%- assign title_head = title_words | pop | join: ' ' -%}
<div class="MultiToCLayout-root">
  <div class="MultiToCLayout-tableOfContents" style="grid-template-areas:&quot;... toc0 gap1 content0 gap2 rhs0 ...&quot; &quot;... toc0 gap1 content1 gap2 rhs1 ...&quot;;grid-template-rows:min-content 1fr">
    <div style="grid-area:toc0" class="MultiToCLayout-toc MultiToCLayout-normalHeaderToc">
      <div class="MultiToCLayout-stickyBlockScroller MultiToCLayoutStickyBlockScroller">
        <div class="MultiToCLayout-stickyBlock">
          <div class="FixedPositionToC-root" id="fixed-toc">
            <div class="FixedPositionToC-tocWrapper">
              <div class="TableOfContentsRow-root TableOfContentsRow-title FixedPositionToC-headingOpacity">
                <div class="FixedPositionToC-tocTitle">{{ title }}</div>
                {% if is_post %}<div class="ReadTime-root FixedPositionToC-readTime">{{ read_time }} min read</div>{% endif %}
              </div>
            </div>
            <div class="FixedPositionToC-wrapper">
              <div class="FixedPositionToC-progressBarContainer"><div class="FixedPositionToC-progressBar" id="toc-progress"></div></div>
              <div class="FixedPositionToC-rows" id="toc-rows"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="MultiToCLayout-gap1"></div>
    <div class="MultiToCLayout-content" style="grid-area:content0">
      <div id="postBody" class="PostsPage-centralColumn PostsPage-postBody PostsPage-audioPlayerHidden">
        <div class="PostsPage-title">
          <div class="PostsPage-centralColumn">
            <div class="LWPostsPageHeader-root">
              <div class="LWPostsPageHeader-titleSection">
                <div class="LWPostsPageHeader-title">
                  <div>
                    <h1 class="Typography-root Typography-display3 PostsPageTitle-root post-title">
                      <a class="PostsPageTitle-link" href="{{ page.url | relative_url }}">{% if title_head != '' %}{{ title_head }} {% endif %}<span class="PostsPageTitle-lastWord">{{ last_word }}</span></a>
                    </h1>
                  </div>
                  <div class="LWPostsPageHeader-authorAndSecondaryInfo">
                    {%- if page.date %}
                    {%- if is_post %}
                    <div class="LWPostsPageHeader-authorInfo"><span class="Typography-root Typography-body1 PostsAuthors-root">by <span class="PostsAuthors-authorName"><a class="UsersNameDisplay-noColor" href="{{ '/' | relative_url }}">{{ author_name }}</a></span></span></div>
                    {%- endif %}
                    <div class="LWPostsPageHeader-date"><span class="PostsPageDate-date"><time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date_to_string: 'ordinal' }}</time></span></div>
                    {%- if is_post %}
                    <div class="LWPostsPageHeader-readTime"><span class="ReadTime-root post-readtime">{{ read_time }} min read</span></div>
                    {%- endif %}
                    {%- if last_date %}<div class="LWPostsPageHeader-updated"><span class="PostsPageDate-date">updated {{ last_date | date_to_string: 'ordinal' }}</span></div>{% endif %}
                    {%- elsif page.description %}
                    <div class="site-pageDescription">{{ page.description }}</div>
                    {%- endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="PostsPage-postContent instapaper_body ContentStyles-base content ContentStyles-postBody">
          <div class="commentOnSelection">
            <div id="postContent">
              <div>
                <div id="markdown-content">
                  {{ content }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="MultiToCLayout-rhs" style="grid-area:rhs0"><div class="PostsPage-reserveSpaceForSidenotes"></div><div class="SideItems-sidebar"></div></div>
    <div class="MultiToCLayout-gap1"></div>
    <div class="MultiToCLayout-content" style="grid-area:content1">
      <div class="PostsPage-centralColumn PostsPage-betweenPostAndComments">
        {%- if is_post %}
        <div class="PostsPagePostFooter-root">
          <div class="PostsPagePostFooter-footerTagList post-tags">
            <div class="FooterTagList-root">
              {%- for tag in page.tags -%}
                <a class="FooterTag-root FooterTag-core" href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">{{ tag }}</a>
              {%- endfor -%}
              {%- for category in page.categories -%}
                <a class="FooterTag-root FooterTag-core" href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">{{ category }}</a>
              {%- endfor -%}
              <a class="FooterTag-root FooterTag-core" href="{{ year | prepend: '/blog/' | append: '/' | relative_url }}">{{ year }}</a>
            </div>
          </div>
        </div>
        {%- endif %}
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    // Contents rail: one row per heading, each row sized by the length of its section,
    // a progress bar for the viewport, the current section highlighted, revealed on hover.
    const article = document.getElementById('markdown-content');
    const rows = document.getElementById('toc-rows');
    const toc = document.getElementById('fixed-toc');
    const bar = document.getElementById('toc-progress');
    const headings = [...article.querySelectorAll('h2, h3, h4')];
    if (!headings.length) { toc.hidden = true; return; }
    headings.forEach((h, i) => { if (!h.id) h.id = 'section-' + i; });
    const tops = () => headings.map(h => h.getBoundingClientRect().top + window.scrollY);
    const docEnd = () => article.getBoundingClientRect().bottom + window.scrollY;
    const entries = headings.map(h => {
      const level = Number(h.tagName[1]) - 1;
      const wrap = document.createElement('div');
      wrap.className = 'FixedPositionToC-rowWrapper';
      wrap.innerHTML = '<div class="FixedPositionToC-rowDotContainer"><div class="FixedPositionToC-rowDot">•</div>' +
        '<div class="FixedPositionToC-rowOpacity"><div class="TableOfContentsRow-root TableOfContentsRow-level' + level + '">' +
        '<a class="TableOfContentsRow-link TableOfContentsRow-highlightDot"></a></div></div></div>';
      const link = wrap.querySelector('a');
      link.href = '#' + h.id;
      link.textContent = h.textContent.trim();
      rows.append(wrap);
      return { wrap, row: wrap.querySelector('.TableOfContentsRow-root') };
    });
    const sizeRows = () => {
      const t = tops(), end = docEnd();
      entries.forEach((e, i) => {
        const len = Math.max(1, (i + 1 < t.length ? t[i + 1] : end) - t[i]);
        e.wrap.style.flex = len + ' 1 0px';
      });
    };
    const track = () => {
      const t = tops(), y = window.scrollY, mark = y + window.innerHeight * 0.3;
      let current = -1;
      t.forEach((top, i) => { if (top <= mark) current = i; });
      entries.forEach((e, i) => e.row.classList.toggle('TableOfContentsRow-highlighted', i === current));
      const first = t[0] || 0, span = Math.max(1, docEnd() - first);
      const h = rows.getBoundingClientRect().height;
      const top = Math.max(0, Math.min(h, (y - first) / span * h));
      const height = Math.max(0, Math.min(h - top, window.innerHeight / span * h));
      bar.style.setProperty('--windowTop', top + 'px');
      bar.style.setProperty('--windowHeight', height + 'px');
    };
    toc.addEventListener('mouseenter', () => toc.classList.add('FixedPositionToC-hover'));
    toc.addEventListener('mouseleave', () => toc.classList.remove('FixedPositionToC-hover'));
    const refresh = () => { sizeRows(); track(); };
    window.addEventListener('scroll', track, { passive: true });
    window.addEventListener('resize', refresh);
    window.addEventListener('load', refresh);
    if (document.fonts) document.fonts.ready.then(refresh);
    refresh();
  })();
</script>
